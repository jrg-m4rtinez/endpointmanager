# Endpoint Manager v2: copie para .env e ajuste. Valores abaixo são os do LAB
# (docker-compose.lab.yml). Comentários "PRODUÇÃO" indicam o que muda.

# --- Postgres do app ---
# PRODUÇÃO: host/credenciais do Postgres compartilhado com o Grafana.
PG_HOST=db
PG_PORT=5432
PG_USER=endpoint
PG_PASSWORD=endpoint
PG_DATABASE=endpoint
# Usados só pelo container db do lab (espelham PG_*). PRODUÇÃO: não usados.
POSTGRES_USER=endpoint
POSTGRES_PASSWORD=endpoint
POSTGRES_DB=endpoint

# --- App ---
# URL pública do frontend (sem barra final). PRODUÇÃO: https://<host>; https liga cookie Secure.
APP_BASE_URL=http://localhost:3000
# Obrigatório. Gere com: openssl rand -hex 32
SESSION_SECRET=
# E-mail que vira admin no primeiro login. PRODUÇÃO: e-mail corporativo do responsável.
BOOTSTRAP_ADMIN_EMAIL=admin@lab.local

# --- OIDC ---
# PRODUÇÃO (Entra ID): OIDC_ISSUER=https://login.microsoftonline.com/<tenant-id>/v2.0,
# client id/secret do App Registration, redirect URI = APP_BASE_URL + /api/auth/callback.
OIDC_ISSUER=http://host.docker.internal:8082/realms/endpoint-manager
OIDC_CLIENT_ID=endpoint-manager
OIDC_CLIENT_SECRET=lab-secret-troque-em-producao

# --- DefectDojo (opcional; só leitura) ---
# PRODUÇÃO: URL do DefectDojo e token de um usuário de leitura.
DD_URL=http://host.docker.internal:8081
DD_API_KEY=
